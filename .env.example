# Synomni Chamber — Environment Variables
# Copy this file to .env.local and set real values there (never commit .env.local)

# Provider request timeout in milliseconds (default: 30000)
# PROVIDER_TIMEOUT_MS=30000

# Path to the memory JSON file (default: ./data/memory.json)
# MEMORY_FILE=./data/memory.json

# Set to "true" to allow Local provider URLs resolving to private/loopback IPs
# ALLOW_LOCAL_URLS=false

# Comma-separated hostname allowlist for Local provider URLs (optional)
# LOCAL_URL_ALLOWLIST=localhost,my-ollama.local

# ── Hosted public demo mode (Task 9) ────────────────────────────────────────

# Set to "true" to enable hosted-demo mode.
# Effects: Local provider is blocked (403), rate limiting is active,
# memory is namespaced per anonymous session cookie.
# HOSTED_DEMO=false

# Rate limit for /api/chat and /api/conference (requests per IP per minute, default 30)
# RATE_LIMIT_CHAT_PER_MIN=30

# Rate limit for /api/memory write operations (requests per IP per minute, default 20)
# RATE_LIMIT_WRITE_PER_MIN=20

# Set to "true" to enable rate limiting independently of HOSTED_DEMO
# RATE_LIMIT=false

# Directory for per-session memory files in hosted mode (default: ./data/sessions)
# MEMORY_DIR=./data/sessions

# Session time-to-live in hours; sessions older than this are purged (default: 24)
# SESSION_TTL_HOURS=24
